{% style %}
  .cart-section {
    padding: 60px 0;
    min-height: 400px;
  }

  .cart-section h1 {
    margin-bottom: 2rem;
    color: var(--primary-dark);
  }

  .cart-empty {
    text-align: center;
    padding: 40px;
    background-color: var(--light-gray);
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  .cart-empty p {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: 2rem;
  }

  .btn-continue {
    display: inline-block;
    padding: 12px 32px;
    background-color: var(--navy-blue);
    color: white;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: all 0.3s;
  }

  .btn-continue:hover {
    background-color: var(--primary-dark);
  }

  .cart-items {
    display: grid;
    gap: 20px;
    margin-bottom: 40px;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 100px 1fr 100px 100px;
    gap: 20px;
    align-items: center;
    padding: 20px;
    background-color: white;
    border: 1px solid var(--light-gray);
    border-radius: 8px;
  }

  .cart-item-image {
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, #f5f5f0 0%, #e8e8e8 100%);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
    border: 1px solid var(--accent-gold);
  }

  .cart-item-details h3 {
    color: var(--primary-dark);
    margin-bottom: 0.5rem;
  }

  .cart-item-price {
    color: var(--accent-gold);
    font-weight: 600;
  }

  .cart-summary {
    background-color: var(--light-gray);
    padding: 30px;
    border-radius: 8px;
    max-width: 400px;
    margin-left: auto;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid white;
  }

  .summary-row.total {
    border-bottom: none;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--primary-dark);
  }

  .btn-checkout {
    width: 100%;
    padding: 16px;
    background-color: var(--navy-blue);
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    margin-top: 1rem;
    transition: all 0.3s;
  }

  .btn-checkout:hover {
    background-color: var(--primary-dark);
  }

  @media (max-width: 768px) {
    .cart-item {
      grid-template-columns: 80px 1fr;
      gap: 15px;
    }

    .cart-summary {
      max-width: 100%;
      margin-left: 0;
      margin-top: 2rem;
    }
  }
{% endstyle %}

<section class="cart-section">
  <div class="container">
    <h1>Votre Panier</h1>
    
    {% if cart.item_count == 0 %}
      <div class="cart-empty">
        <p>Votre panier est vide</p>
        <a href="/collections/all" class="btn-continue">Continuer vos achats</a>
      </div>
    {% else %}
      <div class="cart-items">
        {% for item in cart.items %}
          <div class="cart-item">
            <div class="cart-item-image">📦</div>
            <div class="cart-item-details">
              <h3>{{ item.product.title }}</h3>
              <p class="cart-item-price">{{ item.price | money }}</p>
            </div>
            <div>
              <form method="post" action="/cart/change">
                <input type="hidden" name="id" value="{{ item.key }}">
                <input type="number" name="quantity" value="{{ item.quantity }}" min="1" style="width: 50px; padding: 5px; border: 1px solid var(--light-gray);">
              </form>
            </div>
            <div>
              <form method="post" action="/cart/remove">
                <input type="hidden" name="id" value="{{ item.key }}">
                <button type="submit" style="background: none; border: none; color: #e74c3c; cursor: pointer; font-weight: bold;">Retirer</button>
              </form>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="cart-summary">
        <div class="summary-row">
          <span>Sous-total:</span>
          <span>{{ cart.subtotal_price | money }}</span>
        </div>
        <div class="summary-row">
          <span>Frais de port:</span>
          <span>À déterminer</span>
        </div>
        <div class="summary-row total">
          <span>Total:</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <a href="/checkout" class="btn-checkout">Passer la commande</a>
      </div>
    {% endif %}
  </div>
</section>
