<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1a1a1a">
  <title>{{ page_title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {% style %}
    :root {
      --primary-dark: {{ settings.primary_dark }};
      --accent-gold: {{ settings.accent_color }};
      --off-white: #f5f5f0;
      --light-gray: #e8e8e8;
      --navy-blue: #2c3e50;
      --text-dark: #2c2c2c;
      --text-light: #666666;
      --page-width: {{ settings.page_width }}px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: {{ settings.font_body_family }};
      background-color: var(--off-white);
      color: var(--text-dark);
      line-height: 1.6;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: {{ settings.font_heading_family }};
      font-weight: 600;
      letter-spacing: -0.5px;
    }

    .container {
      max-width: var(--page-width);
      margin: 0 auto;
      padding: 0 20px;
    }

    /* Header */
    header {
      background-color: var(--primary-dark);
      color: white;
      padding: 1rem 0;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    header .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--accent-gold);
      text-decoration: none;
      letter-spacing: 2px;
    }

    nav {
      display: flex;
      gap: 2rem;
      align-items: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.3s;
    }

    nav a:hover {
      color: var(--accent-gold);
    }

    .cart-icon {
      cursor: pointer;
      font-size: 1.2rem;
      position: relative;
      color: white;
      text-decoration: none;
    }

    .cart-icon:hover {
      color: var(--accent-gold);
    }

    .cart-count {
      position: absolute;
      top: -8px;
      right: -8px;
      background: var(--accent-gold);
      color: var(--primary-dark);
      border-radius: 50%;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      font-weight: bold;
    }

    /* Footer */
    footer {
      background-color: var(--primary-dark);
      color: white;
      padding: 40px 0;
      margin-top: 60px;
    }

    footer .container {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }

    footer h4 {
      color: var(--accent-gold);
      margin-bottom: 1rem;
    }

    footer a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      transition: color 0.3s;
    }

    footer a:hover {
      color: var(--accent-gold);
    }

    footer ul {
      list-style: none;
    }

    footer li {
      margin-bottom: 0.5rem;
    }

    footer .footer-bottom {
      text-align: center;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      margin-top: 30px;
      padding-top: 20px;
      color: rgba(255, 255, 255, 0.7);
      grid-column: 1 / -1;
    }

    /* Responsive */
    @media (max-width: 768px) {
      nav {
        gap: 1rem;
      }

      footer .container {
        grid-template-columns: 1fr;
      }
    }
  {% endstyle %}

  <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">
</head>
<body>
  <header>
    <div class="container">
      <a href="/" class="logo">LISSIA</a>
      <nav>
        {% for link in linklists.main-menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
        <a href="/cart" class="cart-icon">
          🛒
          {% if cart.item_count > 0 %}
            <span class="cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </nav>
    </div>
  </header>

  <main id="MainContent" class="content-for-index">
    {{ content_for_layout }}
  </main>

  <footer>
    <div class="container">
      <div>
        <h4>Lissia</h4>
        <p>Brosse chauffante professionnelle pour cheveux. Qualité premium, prix accessible. Produit halal et conforme aux normes islamiques.</p>
      </div>
      <div>
        <h4>Liens rapides</h4>
        <ul>
          <li><a href="/pages/about">À propos</a></li>
          <li><a href="/policies/terms-of-service">Conditions générales</a></li>
          <li><a href="/policies/privacy-policy">Politique de confidentialité</a></li>
          <li><a href="/pages/returns">Retours & échanges</a></li>
        </ul>
      </div>
      <div>
        <h4>Contactez-nous</h4>
        <ul>
          <li><a href="mailto:contact@lissia.fr">contact@lissia.fr</a></li>
          <li><a href="tel:+33123456789">+33 (0)1 23 45 67 89</a></li>
          <li>Du lundi au vendredi, 9h-18h</li>
        </ul>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2024 Lissia. Tous droits réservés.</p>
        <p style="font-size: 0.85rem; margin-top: 10px;">Produit halal - Conforme aux valeurs islamiques</p>
      </div>
    </div>
  </footer>
</body>
</html>
