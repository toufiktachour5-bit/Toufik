{% style %}
  .product-page {
    padding: 60px 0;
    background-color: white;
  }

  .product-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .product-image {
    background-color: var(--light-gray);
    border-radius: 8px;
    padding: 40px;
    text-align: center;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 120px;
  }

  .product-details h1 {
    font-size: 2.5rem;
    color: var(--primary-dark);
    margin-bottom: 1rem;
  }

  .price {
    font-size: 2.5rem;
    color: var(--accent-gold);
    font-weight: 700;
    margin: 1.5rem 0;
  }

  .rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .features {
    background-color: var(--light-gray);
    padding: 20px;
    border-radius: 8px;
    margin: 2rem 0;
  }

  .features h4 {
    color: var(--primary-dark);
    margin-bottom: 1rem;
  }

  .features ul {
    list-style: none;
  }

  .features li {
    padding: 8px 0;
    padding-left: 24px;
    position: relative;
    color: var(--text-dark);
  }

  .features li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent-gold);
    font-weight: bold;
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0;
  }

  .quantity-selector input {
    width: 60px;
    padding: 8px;
    border: 1px solid var(--light-gray);
    border-radius: 4px;
    text-align: center;
  }

  .add-to-cart {
    width: 100%;
    padding: 16px 32px;
    margin-top: 1rem;
    background-color: var(--navy-blue);
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }

  .add-to-cart:hover {
    background-color: var(--primary-dark);
  }

  @media (max-width: 768px) {
    .product-container {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .product-details h1 {
      font-size: 1.8rem;
    }
  }
{% endstyle %}

<section class="product-page">
  <div class="container">
    <div class="product-container">
      <div class="product-image">💇‍♀️</div>
      
      <div class="product-details">
        <h1>{{ product.title }}</h1>
        
        <div class="price">{{ product.price | money }}</div>
        
        <div class="rating">
          <span>⭐ 4.8</span>
          <span style="color: var(--text-light); font-size: 0.9rem;">(247 avis)</span>
        </div>
        
        <p style="font-size: 1.1rem; line-height: 1.8; margin-bottom: 1.5rem;">{{ product.description }}</p>
        
        {% if product.available %}
          <div class="features">
            <h4>Caractéristiques</h4>
            <ul>
              <li>Chauffage rapide en 30 secondes</li>
              <li>3 niveaux de température</li>
              <li>Technologie ionique anti-frisottis</li>
              <li>Autonomie 90 minutes</li>
              <li>Câble USB-C rechargeable</li>
            </ul>
          </div>

          <form method="post" action="/cart/add">
            <div class="quantity-selector">
              <label for="quantity" style="font-weight: 600;">Quantité:</label>
              <input type="number" id="quantity" name="quantity" value="1" min="1" max="10">
            </div>
            
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
            <button type="submit" class="add-to-cart">Ajouter au panier 🛒</button>
          </form>
        {% else %}
          <p style="color: #e74c3c; font-weight: 600; font-size: 1.1rem;">Actuellement en rupture de stock</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>
